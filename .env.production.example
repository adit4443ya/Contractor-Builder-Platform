# BuildConnect Production Environment Variables
# Copy these to Vercel Dashboard → Settings → Environment Variables

# === SUPABASE (REQUIRED) ===
# Get from: https://supabase.com/dashboard → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inhxxxxxxxxxxxxxx...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inhxxxxxxxxxxxxxx...

# === APP URL (REQUIRED) ===
# Your Vercel deployment URL (update after first deploy)
NEXT_PUBLIC_URL=https://buildconnect-xxxxxxxxxxx.vercel.app

# === EMAIL (OPTIONAL) ===
# Get from: https://resend.com/api-keys
# App works without this, just won't send email notifications
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxx

# === DEPLOYMENT CHECKLIST ===
# [ ] Created Supabase project
# [ ] Ran supabase-schema.sql in SQL Editor
# [ ] Copied all 3 Supabase keys above
# [ ] Added all variables to Vercel
# [ ] Deployed to Vercel
# [ ] Updated NEXT_PUBLIC_URL with actual Vercel URL
# [ ] Updated Supabase Auth URLs
# [ ] Tested signup/login flow
# [ ] Tested complete bid flow
